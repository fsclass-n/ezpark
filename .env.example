# =========================================================
# EzPark 환경변수 예시 – 이 파일을 .env 로 복사한 뒤 값을 채운다 (.env 는 커밋 금지)
#   cp .env.example .env
# Render / AWS EC2 배포 시에는 같은 이름의 환경변수를 서비스 설정에 등록한다.
# =========================================================

# --- TiDB Cloud (Serverless) : 콘솔 > Connect > Java(JDBC) 에서 호스트/계정 확인 ---
# TLS 필수, 한국 시간으로 세션 시간대를 맞춘다.
DB_URL=jdbc:mysql://gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/ezpark?createDatabaseIfNotExist=true&sslMode=VERIFY_IDENTITY&enabledTLSProtocols=TLSv1.2,TLSv1.3&connectionTimeZone=Asia/Seoul&forceConnectionTimeZoneToSession=true&characterEncoding=UTF-8
DB_USERNAME=xxxxxxxxxxxx.root
DB_PASSWORD=

# --- 최초 기동 시 생성할 관리자 계정 (비밀번호를 비우면 생성하지 않음) ---
EZPARK_ADMIN_EMAIL=admin@ezpark.kr
EZPARK_ADMIN_PASSWORD=

# --- 외부 API (비워 두면 해당 기능은 대체 동작) ---
# Google AI Studio 에서 발급 – 없으면 AI 어시스턴트가 규칙 기반 답변을 사용
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# 공공데이터포털 「전국주차장정보표준데이터」 인증키(Decoding) – 관리자 > 주차장 > 공공데이터 동기화
PUBLIC_DATA_SERVICE_KEY=

# --- 운영 옵션 ---
# 잔여면·관제 이벤트 데모 시뮬레이터 (P3 영상 인지 연동 후 false)
EZPARK_SIMULATOR_ENABLED=true
# HTTPS 배포 환경(Render 등)에서는 true
SESSION_COOKIE_SECURE=false
